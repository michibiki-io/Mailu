SECRET_KEY=fixture-only-shared-mailu-key
DOMAIN=example.org
HOSTNAMES=mail.example.org
POSTMASTER=alice
ADMIN=true
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEBROOT_REDIRECT=/webmail
WEBMAIL=${WEBMAIL:-roundcube}
WEB_BASE_PATH=${WEB_BASE_PATH:-}
WEBDAV=none
TLS_FLAVOR=cert
TLS_PERMISSIVE=false
PORTS=25,80,443,143,993
CPU_COUNT=1
MESSAGE_SIZE_LIMIT=50000000
RECIPIENT_DELIMITER=+
DISABLE_STATISTICS=true
OIDC_ENABLED=true
OIDC_PROVIDER_INFO_URL=https://idp:8443
OIDC_REDIRECT_HOST=mail.example.org
OIDC_CLIENT_ID=mailu
OIDC_CLIENT_SECRET=fixture-only-client-secret
OIDC_INTROSPECTION_CACHE_TTL=0
